{
  "name": "solve2git",
  "version": "0.1.0",
  "private": true,
  "description": "Sync accepted LeetCode solutions to GitHub.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
